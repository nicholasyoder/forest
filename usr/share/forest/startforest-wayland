#!/bin/sh

export XDG_DATA_DIRS="/usr/local/share/:/usr/share/:/usr/share/gdm/:/var/lib/menu-xdg/"

if [ -z "$XDG_CONFIG_HOME" ]; then
	export XDG_CONFIG_HOME="$HOME/.config"
fi

if [ -z "$XDG_DATA_HOME" ]; then
	export XDG_DATA_HOME="$HOME/.local/share"
fi

# Set qt5ct settings
QT5CT_CONF_DIR="$XDG_CONFIG_HOME/qt5ct"
if [ ! -f "$QT5CT_CONF_DIR/qt5ct.conf" ]; then
	mkdir -p "$QT5CT_CONF_DIR"
	cp /usr/share/forest/qtct.conf "$QT5CT_CONF_DIR/qt5ct.conf"
fi

# Set qt6ct settings
QT6CT_CONF_DIR="$XDG_CONFIG_HOME/qt6ct"
if [ ! -f "$QT6CT_CONF_DIR/qt6ct.conf" ]; then
	mkdir -p "$QT6CT_CONF_DIR"
	cp /usr/share/forest/qtct.conf "$QT6CT_CONF_DIR/qt6ct.conf"
fi

# Setup gtk-2.0 themes
GTK2_CONF_FILE="$HOME/.gtkrc-2.0"
if [ ! -f "$GTK2_CONF_FILE" ]; then
	cat << EOF > "$GTK2_CONF_FILE"
# Autogenerated by Forest

gtk-theme-name="Forest"
gtk-icon-theme-name="Papirus"
gtk-font-name="Sans 10"

EOF
fi

# Setup gtk-3.0 themes
GTK3_CONF_DIR="$XDG_CONFIG_HOME/gtk-3.0"
GTK3_CONF_FILE="$GTK3_CONF_DIR/settings.ini"
if [ ! -f "$GTK3_CONF_FILE" ]; then
	mkdir -p "$GTK3_CONF_DIR"
	cat << EOF > "$GTK3_CONF_FILE"
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=Papirus
gtk-font-name=Sans 10
gtk-toolbar-style=GTK_TOOLBAR_BOTH_HORIZ
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintmedium

EOF
fi

#export XDG_MENU_PREFIX="forest-"
# "biome" is included here (not just "Forest") so xdg-desktop-portal's
# desktop-specific config lookup (see portals.conf(5)) finds
# biome-portals.conf, which is what tells the portal frontend to route
# org.freedesktop.impl.portal.GlobalShortcuts to Biome's own backend -
# without it, foresthotkeys' portal session creation silently has no
# backend to bind to and hotkeys don't fire.
export XDG_CURRENT_DESKTOP="Forest:biome"
export QT_QPA_PLATFORMTHEME="qt6ct"
export XDG_SESSION_TYPE="wayland"

# Export the cursor settings saves to index.theme for clients that only read
# XCURSOR_THEME/XCURSOR_SIZE (SDL, XWayland GTK).
INDEX_THEME="$HOME/.icons/default/index.theme"
if [ -f "$INDEX_THEME" ]; then
	XCURSOR_THEME_VALUE=$(sed -n 's/^Inherits=//p' "$INDEX_THEME" | head -1)
	XCURSOR_SIZE_VALUE=$(sed -n 's/^Size=//p' "$INDEX_THEME" | head -1)
	[ -n "$XCURSOR_THEME_VALUE" ] && export XCURSOR_THEME="$XCURSOR_THEME_VALUE"
	[ -n "$XCURSOR_SIZE_VALUE" ] && export XCURSOR_SIZE="$XCURSOR_SIZE_VALUE"
fi

dbus-update-activation-environment --systemd --all

# Biome and everything it forks inherit this stderr; keep the previous session's log.
# Same dir and .1 rotation as FLogger.
LOG_DIR="$XDG_DATA_HOME/forest/logs"
mkdir -p "$LOG_DIR"
[ -f "$LOG_DIR/biome.log" ] && mv -f "$LOG_DIR/biome.log" "$LOG_DIR/biome.log.1"

# Biome forks forest-session (-s) once its Wayland socket is live.
exec /usr/bin/biome -s /usr/bin/forest-session >"$LOG_DIR/biome.log" 2>&1
